# Cyberon — nombres de variables (sin valores reales; el archivo .env está en .gitignore).
# La app Flutter las recibe con --dart-define, por ejemplo:
#   flutter run -d <dispositivo> --dart-define=FIREBASE_API_KEY=...

# Clave de API web de Firebase (Configuración del proyecto → General). Pública por
# diseño: la seguridad real la dan las reglas de firebase/firestore.rules.
FIREBASE_API_KEY=

# Token público de Mapbox (opcional; la app trae uno por defecto).
MAPBOX_ACCESS_TOKEN=

# Condiciones recordadas (RF-26, opcional). URL de services/preferences_api; sin
# ella la tarjeta "Tus condiciones de siempre" no aparece.
TRIP_MEMORY_API_URL=

# Solo para services/preferences_api (servidor; NUNCA en la app):
# ATOMICMEMORY_API_URL=https://api.atomicstrata.ai
# ATOMICMEMORY_API_KEY=
# ALLOWED_ORIGINS=http://localhost:8085
